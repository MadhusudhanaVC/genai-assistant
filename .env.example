# ==================================================
# GenAI Assistant Environment Configuration
# ==================================================
# Copy this file to ".env" before running the project.
# Never commit your real ".env" file to Git.

# ----------------------------
# Application Settings
# ----------------------------
APP_NAME=GenAI Assistant
APP_ENV=development
DEBUG=True

# ----------------------------
# OpenAI API Configuration
# ----------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ----------------------------
# Database Configuration
# ----------------------------
DATABASE_URL=sqlite:///genai.db

# ----------------------------
# Logging Configuration
# ----------------------------
LOG_LEVEL=INFO


# Paste your actual OpenRouter API key below.
OPENROUTER_API_KEY=your_openrouter_api_key

# Free model for Day 3
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# OpenRouter API URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1


